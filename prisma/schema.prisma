generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Audit {
  id                    String   @id @default(cuid())
  url                   String
  email                 String
  businessName          String?
  score                 Int?
  confidenceLevel       String?
  aiDescription         String?  @db.Text
  analysisJson          Json?
  reportHtml            String?  @db.Text
  rawCrawlData          Json?
  stage2InterestClicked Boolean  @default(false)
  status                String   @default("pending")
  errorMessage          String?
  ipAddress             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([url])
  @@index([email])
  @@index([createdAt])
}

model AdminSettings {
  id         String @id @default("default")
  adminEmail String @default("mark.fenty@gmail.com")
}
