# Copy this file to .env and fill in real values before running locally.
# Do NOT commit the real .env to GitHub.

# PostgreSQL connection string
DATABASE_URL=

# Abacus.AI API key (LLM analysis + email notifications)
ABACUSAI_API_KEY=

# Abacus web app id
WEB_APP_ID=

# Email notification type IDs
NOTIF_ID_NEW_AUDIT_SUBMISSION=
NOTIF_ID_FULL_ACTION_PLAN_PURCHASE_REQUEST=
NOTIF_ID_FREE_SNAPSHOT_CONFIRMATION=